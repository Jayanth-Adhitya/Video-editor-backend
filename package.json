{
  "name": "video-editor-backend",
  "version": "1.0.0",
  "description": "Backend API for a web-based video editing platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:worker": "node src/worker.js",
    "dev:server": "nodemon server.js",
    "dev:worker": "nodemon src/worker.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [
    "video",
    "editing",
    "api",
    "node",
    "express",
    "ffmpeg",
    "prisma",
    "bullmq"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "bullmq": "^5.51.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "fluent-ffmpeg": "^2.1.2",
    "http-errors": "^2.0.0",
    "ioredis": "^5.4.1",
    "multer": "^1.4.5-lts.1",
    "pino": "^8.21.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "pino-pretty": "^11.0.0",
