NODE_ENV=development
PORT=3000

# Database URL (replace with your PostgreSQL connection string)
# Example: DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/video_editor?schema=public"

# Redis Connection (for BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password (if applicable)

# Base URL for file access (adjust if needed, e.g., for S3 down the line)
APP_BASE_URL=http://localhost:3000

# Storage Paths (relative to project root)
RAW_UPLOADS_DIR=uploads/raw
PROCESSED_UPLOADS_DIR=uploads/processed